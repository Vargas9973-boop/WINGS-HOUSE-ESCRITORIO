{
  "name": "wings-house-admin",
  "version": "2.2.5",
  "description": "KATSAM Sistema de gestión para restaurantes - Ventas, Catálogo, Inventarios, Merma, Costos y Asistencia (Supabase)",
  "main": "main.js",
  "author": "KATSAM",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "node --test tests/*.test.js",
    "test:mem": "node scripts/memory-leak-test.js",
    "test:stability": "node scripts/stability-test.js",
    "onboard": "node scripts/onboard-tenant.js"
  },
  "dependencies": {
    "@sentry/electron": "^7.17.0",
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^16.6.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "node-hid": "^3.4.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.wingshouse.escritorio",
    "productName": "Sistema Sucursal",
    "icon": "build/icon.ico",
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "sucursal-setup.${ext}"
    },
    "extraResources": [
      {
        "from": ".",
        "to": ".",
        "filter": [
          "config.json"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Vargas9973-boop",
        "repo": "WINGS-HOUSE-ESCRITORIO"
      }
    ]
  }
}
